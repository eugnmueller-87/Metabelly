{
  "name": "11-contact-form",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "metabelly-contact",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-trigger",
      "name": "Contact Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst name = (body.name || '').substring(0, 100).replace(/[<>]/g, '');\nconst email = (body.email || '').substring(0, 200).replace(/[<>]/g, '');\nconst message = (body.message || '').substring(0, 2000).replace(/[<>]/g, '');\nconst context = (body.context || '').substring(0, 500);\n\nif (!email || !message) {\n  throw new Error('Missing required fields: email and message');\n}\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!emailRegex.test(email)) {\n  throw new Error('Invalid email address');\n}\n\nreturn [{\n  json: {\n    name: name || '(no name)',\n    email,\n    message,\n    context,\n    source: 'contact_form',\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "validate-input",
      "name": "Validate & Sanitize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/appT9NVuu8MyFHFsj/tblHtfXkcsmWjk1aQ",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AIRTABLE_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  records: [{\n    fields: {\n      Customer: $json.name,\n      Email: $json.email,\n      Subject: 'Contact form — chat widget fallback',\n      Category: 'FAQ',\n      Priority: 'P2',\n      Summary: $json.message.substring(0, 200),\n      'Order Status': 'New',\n      Received: $json.receivedAt\n    }\n  }]\n}) }}",
        "options": {}
      },
      "id": "create-airtable",
      "name": "Add to Airtable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SLACK_WEBHOOK_FAQ }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=📬 *Nova poruka — Contact Form (chat widget)*\n*Ime:* {{ $json.name }}\n*Email:* {{ $json.email }}\n*Poruka:* {{ $json.message.substring(0, 400) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-slack",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        }
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Contact Form Webhook": {
      "main": [[{ "node": "Validate & Sanitize", "type": "main", "index": 0 }]]
    },
    "Validate & Sanitize": {
      "main": [
        [
          { "node": "Add to Airtable", "type": "main", "index": 0 },
          { "node": "Notify Slack", "type": "main", "index": 0 }
        ]
      ]
    },
    "Add to Airtable": {
      "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]]
    },
    "Notify Slack": {
      "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "metabelly" }]
}
